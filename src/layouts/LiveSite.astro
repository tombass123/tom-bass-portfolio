---
const { title = "Home" } = Astro.props;
const links = [
  ["/#acting", "Acting"],
  ["/#theatre-making", "Theatre Making"],
  ["/#live-events", "Live Events"],
  ["/#contact", "Contact"],
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Tom Bass</title>
    <meta name="description" content="Tom Bass — Actor and Theatre Maker. Theatre, music and live events." />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Tom Bass home">
        <span class="brand-name">Tom Bass</span>
        <span class="brand-role">Actor and Theatre Maker</span>
      </a>
      <nav aria-label="Main navigation">
        {links.map(([href, label]) => <a href={href} aria-current={Astro.url.pathname.replace(/\/$/, '') === href.replace(/\/$/, '') ? 'page' : undefined}>{label}</a>)}
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer>© {new Date().getFullYear()} Tom Bass</footer>
  </body>
</html>
<style is:global>
  * { box-sizing: border-box; }
  body { margin: 0; background: #fff; color: #000; font-family: Helvetica, Arial, sans-serif; }
  a { color: inherit; text-underline-offset: 4px; }
  a:focus-visible, button:focus-visible { outline: 2px solid #170df2; outline-offset: 5px; }
  .skip { position: absolute; top: -100px; }
  .skip:focus { top: 8px; background: white; padding: 12px; z-index: 10; }
  .site-header, main, footer { width: min(1280px, 90%); margin-inline: auto; }
  .site-header { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); align-items: center; gap: clamp(32px, 5vw, 72px); padding: 30px 0 38px; }
  .site-header > nav { width: 100%; max-width: 475px; justify-self: end; justify-content: space-between; column-gap: 12px; }
  nav { display: flex; justify-content: flex-end; flex-wrap: wrap; gap: 18px 30px; font-size: 18px; }
  nav a { text-decoration: none; line-height: 1.5; }
  nav a[aria-current], nav a:hover { color: #170df2; }
  .brand { display: flex; flex-direction: column; gap: 10px; flex: 0 1 430px; min-width: 0; text-decoration: none; }
  .brand-name { font-size: clamp(44px, 5.5vw, 76px); line-height: 1; letter-spacing: -.05em; margin-left: -.08em; }
  .brand-role { font-size: clamp(16px, 1.5vw, 20px); line-height: 1.45; }
  h1, h2, h3, p { margin-top: 0; }
  h1, h2 { font-weight: 400; }
  h1 { font-size: clamp(34px, 4vw, 54px); }
  h2 { font-size: clamp(26px, 2.7vw, 36px); }
  p { font-size: clamp(18px, 1.7vw, 23px); line-height: 1.65; }
  main { min-height: 40vh; }
  .section { margin-bottom: 72px; }
  .section-portrait { display: block; width: 100%; max-width: 475px; max-height: 560px; object-fit: contain; height: auto; margin: 0 auto 48px; }
  .intro { max-width: 1000px; margin-bottom: 36px; }
  .practice-introduction { width: 100%; max-width: none; font-size: clamp(17px, 1.5vw, 20px); line-height: 1.65; margin: 0 0 30px; }
  main :where(div, article, figure) { min-width: 0; }
  p, figcaption, li, h1, h2 { overflow-wrap: anywhere; }
  .project-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 42px 26px; }
  .project-grid figure { margin: 0; }
  .project-grid img { width: 100%; aspect-ratio: 1; object-fit: cover; display: block; }
  .project-grid figcaption { margin-top: 16px; font-size: 16px; font-weight: 400; line-height: 1.5; }
  .project-grid strong { display: block; font-size: 21px; line-height: 1.3; font-weight: 700; margin-bottom: 8px; }
  footer { padding: 65px 0 30px; font-size: 12px; color: #666; }
  @media (max-width: 1050px) {
    .site-header { display: flex; flex-direction: column; align-items: flex-start; padding: 24px 0 32px; gap: 28px; }
    .site-header > nav { width: auto; max-width: none; justify-content: flex-start; column-gap: 30px; }
    .brand { flex: none; max-width: 100%; }
    nav { justify-content: flex-start; }
  }
  @media (max-width: 700px) {
    nav { gap: 14px 22px; font-size: 16px; }
    .site-header > nav { width: 100%; flex-wrap: nowrap; justify-content: space-between; column-gap: 8px; font-size: clamp(11px, 3.2vw, 16px); }
    .site-header > nav a { white-space: nowrap; }
    .project-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 30px 18px; }
    .section { margin-bottom: 52px; }
  }
  @media (max-width: 480px) { .project-grid { grid-template-columns: 1fr; } }
</style>
