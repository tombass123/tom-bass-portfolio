---
const descriptions = [
  'Tom Bass in a dark polo against a red background',
  'Tom Bass in a blue striped jumper against a blue background',
  'Tom Bass in a jacket against a green background',
  'Tom Bass looking left against a red background',
  'Tom Bass in a red striped jumper against a green background',
];
---
<section class="headshots" aria-labelledby="headshots-heading">
  <h3 id="headshots-heading">Headshots</h3>
  <div class="headshot-grid">
    {descriptions.map((alt, i) => (
      <a href={`/images/headshots/tom-bass-${i + 1}.jpg`} aria-label={`View full-size headshot ${i + 1}`}>
        <img src={`/images/headshots/tom-bass-${i + 1}.jpg`} alt={alt} width="3648" height="5472" loading="lazy" />
      </a>
    ))}
  </div>
  <p class="headshot-credit">Photography by Zoe Birkbeck · Select a photo to view full size</p>
</section>
<style>
  .headshots { margin-top: 48px; }
  h3 { font-size: 28px; font-weight: 500; margin: 0 0 24px; }
  .headshot-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 18px; }
  .headshot-grid a { display: block; }
  .headshot-grid img { display: block; width: 100%; height: auto; }
  .headshot-credit { margin: 4px 0 0; font-size: 11px; line-height: 1.2; }
  @media (max-width: 700px) { .headshot-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; } }
  @media (max-width: 420px) { .headshot-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
