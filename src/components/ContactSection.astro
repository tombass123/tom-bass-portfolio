---
import images from '../data/live-site-images.json';
const { embedded = false } = Astro.props;
---
  <section class:list={["contact", "section", { embedded }]} id="contact" aria-labelledby="contact-heading">
    <h2 id="contact-heading">Bookings / Contact</h2>
    <img class="contact-photo" src="/images/tom-bass-writing.png" alt="Tom Bass writing notes during a theatre workshop" width="800" height="800" />
    <div class="contact-info">
    <p><a href="mailto:tombasstheatre@gmail.com">tombasstheatre@gmail.com</a></p>
    <div class="socials">
      <a href="https://www.instagram.com/tom_ato____/" aria-label="Tom Bass on Instagram"><img src={images.contact[1]} alt="Instagram" width="73" height="73" /></a>
      <a href="https://www.linkedin.com/in/tom-bass-2a3813223/" aria-label="Tom Bass on LinkedIn"><img src={images.contact[2]} alt="LinkedIn" width="73" height="73" /></a>
    </div>
    </div>
  </section>
<style>
  .contact-photo { display: block; width: 100%; max-width: 380px; height: auto; justify-self: center; }
  .contact { display: flex; flex-direction: column; align-items: center; gap: 32px; max-width: 700px; margin-inline: auto; margin-top: -16px; padding: 0 0 50px; text-align: center; }
  .contact.embedded { margin-top: 60px; }
  .contact-info { min-width: 0; }
  .contact h2 { font-size: clamp(32px, 3.6vw, 48px); line-height: 1.15; margin: 0; letter-spacing: -.03em; }
  .socials { display: flex; align-items: center; justify-content: center; gap: 22px; margin-top: 24px; }
  .socials a { display: block; }
  .socials img { display: block; width: 44px; height: 44px; object-fit: contain; }
  .contact p { font-size: clamp(17px, 1.8vw, 23px); line-height: 1.5; margin: 0; overflow-wrap: anywhere; }
  @media (max-width: 700px) { .contact { gap: 28px; padding-top: 0; } }
</style>
