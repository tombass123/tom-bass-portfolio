---
const introduction = "Tom Bass is a Theatre Maker, Performer and Facilitator using clown to explore the surreal quirks and qualities that make us human. He works across Theatre, Music and Live Events, looking to empower people and their stories through connection and play.";
const actingPhotos = [
  { src: "/images/acting/table-scene-portrait.png", width: 648, height: 960, alt: "Two performers sitting opposite each other at a table", caption: "East by Steven Berkoff Directed by Rosie Thackeray. Performed at Edinburgh Fringe (2019)" },
  { src: "/images/acting/table-scene-wide.jpeg", width: 1334, height: 901, alt: "Wide view of two performers in a table scene", caption: "East by Steven Berkoff Directed by Rosie Thackeray. Performed at Edinburgh Fringe (2019)" },
  { src: "/images/acting/table-scene-close.jpeg", width: 760, height: 602, alt: "Close view of the performers in the table scene", caption: "East by Steven Berkoff Directed by Rosie Thackeray. Performed at Edinburgh Fringe (2019)" },
  { src: "/images/acting/solo-performance.png", width: 1080, height: 1350, alt: "Two moments from a solo performance in a striped shirt", caption: "Blip by Tom Bass and Ren Roberts. Performed at Edinburgh Fringe (2025)" },
  { src: "/images/acting/solo-purple-lights.png", width: 1080, height: 1350, alt: "Solo performance under purple stage lighting", caption: "Blip by Tom Bass and Ren Roberts. Performed at Edinburgh Fringe (2025)" },
  { src: "/images/acting/solo-green-lights.png", width: 1080, height: 1350, alt: "Solo performance under green stage lighting", caption: "Blip by Tom Bass and Ren Roberts. Performed at Edinburgh Fringe (2025)" },
  { src: "/images/acting/rehearsal-movement-one.jpg", width: 2768, height: 1848, alt: "Two performers exploring movement in a rehearsal room", caption: "Men Touch by Tom Bass and India Martin. Performed at Leeds Playhouse (2023)" },
  { src: "/images/acting/rehearsal-movement-two.jpg", width: 2768, height: 1848, alt: "Performers with arms extended during rehearsal", caption: "Men Touch by Tom Bass and India Martin. Performed at Leeds Playhouse (2023)" },
  { src: "/images/acting/clown-rehearsal.jpeg", width: 2800, height: 1867, alt: "A performer wearing a red clown nose rehearsing with a scene partner", caption: "Being Born by Tom Bass. Performed at Cabaret Du in Etampes, France (2024)" },
  { src: "/images/acting/sock-party-duet.png", width: 1080, height: 1350, alt: "Two performers seated together onstage", caption: "Sock Party by Tom Bass and Marta Fossati. Performed at Brighton Fringe and The OSO Arts Centre (2026)" },
  { src: "/images/acting/sock-party-solo.png", width: 1080, height: 1350, alt: "Solo performer beneath hanging socks and stage lights", caption: "Sock Party by Tom Bass and Marta Fossati. Performed at Brighton Fringe and The OSO Arts Centre (2026)" },
  { src: "/images/acting/ensemble-rehearsal.jpeg", width: 5412, height: 3608, alt: "An ensemble working together with scripts in rehearsal", caption: "Artist Takeover by Gitika Buttoo and Afshan D’souza-lodhi. Performed at Factory International (2024)" },
];

const theatrePhotos = [
  { src: "/images/theatre-making/ensemble-lift.jpg", width: 1242, height: 813, alt: "An ensemble lifting a performer onstage" },
  { src: "/images/theatre-making/ensemble-line.jpeg", width: 896, height: 610, alt: "An ensemble standing together under stage lighting" },
  { src: "/images/theatre-making/immersive-installation.webp", width: 800, height: 800, alt: "Visitors in an immersive installation of swimming pool images" },
  { src: "/images/theatre-making/collaborative-sketch.jpeg", width: 1008, height: 674, alt: "A sketch of a group collaborating around a keyboard" },
  { src: "/images/theatre-making/lost-and-found.webp", width: 1200, height: 1200, alt: "Illustration of a child and penguin in a boat on icy water" },
  { src: "/images/theatre-making/rehearsal-by-window.jpg", width: 4288, height: 2848, alt: "Two performers rehearsing beside a window with yellow curtains" },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={introduction} />
    <title>Tom Bass — Actor &amp; Theatre-Maker</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header>
      <a class="logo" id="name" href="/" aria-label="Tom Bass home">
        <h1>Tom Bass</h1>
        <span class="role">Actor &amp; Theatre-Maker</span>
      </a>
      <nav aria-label="Main navigation">
        <a href="#about">About</a>
        <a href="#acting">Acting</a>
        <a href="#theatre-making">Theatre-Making</a>
        <a href="#other-work">Other Work</a>
        <a href="#contact">Contact</a>
      </nav>
    </header>
    <main id="main">
      <section class="about" id="about" aria-label="About Tom Bass">
        <p class="introduction">{introduction}</p>
        <img class="about-portrait" src="/images/tom-bass-portrait.jpg" alt="Portrait of Tom Bass" width="3450" height="4313" loading="lazy" />
        <p class="photo-credit">Photography by Zoe Birkbeck</p>
      </section>
      <section class="practice-section" id="acting" aria-labelledby="acting-heading">
        <h2 id="acting-heading">Acting</h2>
        <p class="acting-quote">‘Tom is a mesmerising physical performer’ (The Wee Review, 2025)</p>
        <div class="slideshow" aria-label="Acting photos" aria-roledescription="carousel">
          <a class="project-image" href="/projects/project-one/" aria-label="View Project One">
            {actingPhotos.map((photo, index) => (
              <img data-slide class:list={{ 'is-active': index === 0 }} hidden={index !== 0} data-caption={photo.caption} src={photo.src} alt={photo.alt} width={photo.width} height={photo.height} loading="lazy" />
            ))}
            <span class="image-caption" data-image-caption>{actingPhotos[0].caption}</span>
          </a>
          <div class="slide-controls" hidden>
            <button type="button" data-previous aria-label="Previous acting photo">←</button>
            <span data-count aria-live="off">1 / {actingPhotos.length}</span>
            <button type="button" data-next aria-label="Next acting photo">→</button>
            <button type="button" data-pause>Pause</button>
          </div>
        </div>
      </section>
      <section class="practice-section" id="theatre-making" aria-labelledby="theatre-making-heading">
        <h2 id="theatre-making-heading">Theatre-Making</h2>
        <p>Direction / Facilitation / Production</p>
        <div class="slideshow" aria-label="Theatre-Making images" aria-roledescription="carousel">
          <a class="project-image" href="/projects/project-two/" aria-label="View Project Two">
            {theatrePhotos.map((photo, index) => (
              <img data-slide class:list={{ 'is-active': index === 0 }} hidden={index !== 0} data-caption={'caption' in photo ? photo.caption : photo.alt} src={photo.src} alt={photo.alt} width={photo.width} height={photo.height} loading="lazy" />
            ))}
            <span class="image-caption" data-image-caption>{theatrePhotos[0].alt}</span>
          </a>
          <div class="slide-controls" hidden>
            <button type="button" data-previous aria-label="Previous theatre-making image">←</button>
            <span data-count aria-live="off">1 / {theatrePhotos.length}</span>
            <button type="button" data-next aria-label="Next theatre-making image">→</button>
            <button type="button" data-pause>Pause</button>
          </div>
        </div>
      </section>
      <section class="practice-section" id="other-work" aria-labelledby="other-work-heading">
        <h2 id="other-work-heading">Other Work</h2>
        <p>Sound</p>
        <a class="project-image" href="/projects/project-three/" aria-label="View Project Three">
          <img src="https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?w=1600" alt="Project Three" width="1600" height="1000" loading="lazy" />
          <span class="image-caption">Project Three</span>
        </a>
      </section>
      <section class="contact" id="contact" aria-labelledby="contact-heading">
        <span class="eyebrow">Contact</span>
        <h2 id="contact-heading">Let’s make<br />something together.</h2>
        <p>For conversations, collaborations and enquiries.</p>
      </section>
    </main>
    <footer><span>© {new Date().getFullYear()} Tom Bass</span><span>Actor &amp; Theatre-Maker</span><a href="#name">Back to top ↑</a></footer>
  </body>
</html>
<script>
  document.querySelectorAll<HTMLElement>('.slideshow').forEach((carousel) => {
    const slides = Array.from(carousel.querySelectorAll<HTMLImageElement>('[data-slide]'));
    const controls = carousel.querySelector<HTMLElement>('.slide-controls')!;
    const caption = carousel.querySelector<HTMLElement>('[data-image-caption]')!;
    const count = carousel.querySelector<HTMLElement>('[data-count]')!;
    const pause = carousel.querySelector<HTMLButtonElement>('[data-pause]')!;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let current = 0;
    let paused = reducedMotion.matches;
    let timer: ReturnType<typeof setInterval> | undefined;
    const show = (index: number) => {
      current = (index + slides.length) % slides.length;
      slides.forEach((slide, i) => {
        slide.classList.toggle('is-active', i === current);
        slide.setAttribute('aria-hidden', String(i !== current));
      });
      caption.textContent = slides[current].dataset.caption ?? slides[current].alt;
      count.textContent = `${current + 1} / ${slides.length}`;
    };
    const stop = () => { clearInterval(timer); timer = undefined; };
    const start = () => {
      stop();
      if (!paused && !document.hidden && !carousel.matches(':hover') && !carousel.contains(document.activeElement)) {
        timer = setInterval(() => show(current + 1), 3000);
      }
    };
    carousel.querySelector('[data-previous]')!.addEventListener('click', () => { show(current - 1); start(); });
    carousel.querySelector('[data-next]')!.addEventListener('click', () => { show(current + 1); start(); });
    pause.addEventListener('click', () => {
      paused = !paused;
      pause.textContent = paused ? 'Play' : 'Pause';
      start();
    });
    carousel.addEventListener('mouseenter', stop);
    carousel.addEventListener('mouseleave', start);
    carousel.addEventListener('focusin', stop);
    carousel.addEventListener('focusout', () => setTimeout(start, 0));
    document.addEventListener('visibilitychange', start);
    reducedMotion.addEventListener('change', () => {
      paused = reducedMotion.matches;
      pause.textContent = paused ? 'Play' : 'Pause';
      start();
    });
    slides.forEach((slide) => { slide.hidden = false; });
    show(0);
    controls.hidden = false;
    pause.textContent = paused ? 'Play' : 'Pause';
    start();
  });
</script>
<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { scroll-behavior: smooth; }
  :global(body) { margin: 0; background: #fff; color: #191919; font-family: Helvetica, Arial, sans-serif; }
  :global(a) { color: inherit; text-decoration: none; }
  :global(a:focus-visible) { outline: 2px solid #655f45; outline-offset: 6px; }
  :global(section) { scroll-margin-top: 30px; }
  .skip-link { position: absolute; top: -100px; padding: 12px; background: #fff; }
  .skip-link:focus { top: 10px; }
  header { margin: 0 5%; padding: 28px 0; display: flex; justify-content: space-between; align-items: center; gap: 30px; }
  .logo { display: block; flex-shrink: 0; font-family: Helvetica, Arial, sans-serif; }
  nav { display: flex; flex-wrap: wrap; gap: 38px; font-size: 16px; color: #000; }
  nav a:hover, footer a:hover { text-decoration: underline; text-underline-offset: 5px; }
  .eyebrow { font-size: 11px; font-weight: 400; letter-spacing: 2px; text-transform: uppercase; }
  .logo h1 { font-size: clamp(30px, 3.5vw, 48px); font-weight: 500; line-height: 1.05; letter-spacing: -.045em; margin: 0 0 5px; margin-left: -.1em; }
  .role { display: block; font-size: 14px; line-height: 1.2; letter-spacing: -.3px; }
  .about { margin: 0 5%; padding: 55px 0 80px; }
  .about-portrait { display: block; width: 100%; max-width: 380px; height: auto; margin: 35px auto 0; }
  .photo-credit { max-width: 380px; margin: 2px auto 0; font-size: 10px; line-height: 1.2; color: #666; }
  .introduction { font-family: Helvetica, Arial, sans-serif; font-size: clamp(18px, 1.8vw, 24px); line-height: 1.6; margin: 0; width: 100%; letter-spacing: normal; }
  .practice-section { margin: 0 5%; padding: 45px 0; }
  .practice-section h2 { font-size: clamp(30px, 4vw, 55px); font-weight: 400; letter-spacing: -1px; margin: 0 0 18px; }
  .practice-section p { color: #666; font-size: 14px; margin: 0; }
  #acting h2 { margin-bottom: 32px; }
  .practice-section .acting-quote { color: #000; font-size: clamp(18px, 1.8vw, 24px); line-height: 1.6; }
  #acting .project-image { margin-top: 48px; }
  .project-image { position: relative; display: block; margin-top: 28px; }
  .image-caption { position: absolute; bottom: 16px; left: 50%; transform: translateX(-50%); width: max-content; max-width: calc(100% - 32px); padding: 10px 16px; background: rgb(0 0 0 / 78%); color: #fff; font-size: 14px; line-height: 1.4; text-align: center; opacity: 0; transition: opacity .2s ease; pointer-events: none; }
  .project-image:hover .image-caption, .project-image:focus-visible .image-caption { opacity: 1; }
  @media (hover: none) { .image-caption { opacity: 1; } }
  .project-image img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 8; object-fit: cover; }
  .slideshow .project-image { display: grid; }
  .slideshow .project-image img { grid-area: 1 / 1; height: clamp(320px, 50vw, 650px); aspect-ratio: auto; object-fit: contain; opacity: 0; transition: opacity .8s ease-in-out; }
  .slideshow .project-image img.is-active { opacity: 1; }
  .project-image img[hidden], .slide-controls[hidden] { display: none; }
  .slide-controls { display: flex; justify-content: center; align-items: center; gap: 20px; margin-top: 15px; font-size: 13px; }
  .slide-controls button { font: inherit; color: #191919; background: transparent; border: 0; padding: 10px; cursor: pointer; }
  .slide-controls button:focus-visible { outline: 2px solid #191919; outline-offset: 2px; }
  .contact { padding: 70px 5% 90px; background: #fff; color: #191919; margin-top: 30px; }
  .contact h2 { font-family: Helvetica, Arial, sans-serif; font-size: clamp(40px, 6vw, 85px); font-weight: 400; letter-spacing: -2px; line-height: 1.1; margin: 30px 0; }
  .contact p { font-size: 14px; color: #666; }
  footer { padding: 30px 5%; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 20px; font-size: 11px; }
  @media (max-width: 700px) {
    .project-image img { aspect-ratio: 4 / 3; }
    header { align-items: flex-start; flex-wrap: wrap; gap: 22px; }
    nav { gap: 18px 24px; justify-content: flex-end; font-size: 14px; }
    .about { padding-bottom: 50px; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html) { scroll-behavior: auto; }
    .slideshow .project-image img, .image-caption { transition: none; }
  }
</style>
