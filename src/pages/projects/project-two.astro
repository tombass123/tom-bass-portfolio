---
const project = {
  title: "Project Two",
  category: "Creative",
  description: "A creative exploration of form, colour and visual storytelling.",
  image: "https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?w=1600"
};
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{project.title} — My Portfolio</title>
    <style>
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: Helvetica, Arial, sans-serif;
        background: #faf9f6;
        color: #191919;
      }
      nav {
        display: flex;
        justify-content: space-between;
        padding: 28px 6%;
      }
      a { color: inherit; text-decoration: none; }
      a:hover { opacity: 0.6; }
      .logo { font-size: 20px; font-weight: 700; }
      main { padding: 70px 6% 100px; }
      .category {
        color: #777;
        font-size: 13px;
        text-transform: uppercase;
        letter-spacing: 2px;
      }
      h1 {
        font-size: clamp(48px, 8vw, 110px);
        font-weight: 500;
        letter-spacing: -4px;
        margin: 20px 0;
      }
      .description {
        font-size: 19px;
        line-height: 1.6;
        color: #666;
        max-width: 600px;
        margin-bottom: 60px;
      }
      img {
        display: block;
        width: 100%;
        max-height: 850px;
        object-fit: cover;
      }
      footer {
        padding: 40px 6%;
        
      }
    </style>
  </head>
  <body>
    <nav>
<a class="logo" href="/">TOM BASS</a>      <a href="/">← Back to work</a>
    </nav>

    <main>
      <p class="category">{project.category}</p>
      <h1>{project.title}</h1>
      <p class="description">{project.description}</p>
      <img src={project.image} alt={project.title} />
    </main>

    <footer>
    © {new Date().getFullYear()} TOM BASS
    </footer>
  </body>
</html>